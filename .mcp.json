{
  "mcpServers": {
    "cst-runtime": {
      "cwd": ".",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "./scripts/start-mcp.ps1"
      ],
      "env_vars": [
        "CST_MCP_HOME",
        "CST_MCP_CONFIG",
        "CST_WORKER_PYTHON",
        "CST_PYTHON_LIBS",
        "UV_CACHE_DIR",
        "UV_PYTHON_INSTALL_DIR",
        "SystemRoot",
        "windir"
      ],
      "startup_timeout_sec": 120,
      "tool_timeout_sec": 3600
    }
  }
}
